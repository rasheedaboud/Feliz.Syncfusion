<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Feliz.Syncfusion</PackageId>
    <Title>Feliz.Syncfusion</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>0.4.0</Version>
    <Authors>Rasheed Aboud</Authors>
    <Company>ARMM Services</Company>
    <Description>Type-safe Feliz bindings for Syncfusion EJ2 React controls.</Description>
    <Summary>Type-safe Feliz bindings for Syncfusion EJ2 React controls.</Summary>
    <PackageTags>feliz;fsharp;syncfusion;fable;fable-binding;fable-javascript;safe</PackageTags>
    <FablePackageType>binding</FablePackageType>
    <RepositoryUrl>https://github.com/rasheedaboud/Feliz.Syncfusion</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rasheedaboud/Feliz.Syncfusion</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Added ARMM-complete, strongly typed Feliz bindings for ComboBox, MultiSelect, DateTimePicker, Tooltip, Kanban, DatePicker, FileUploader, SplitButton, Grid, Query, Predicate, JsonAdaptor and DataManager. Added Fable consumer compilation and Chromium mount/update contracts against supported and registry-latest Syncfusion packages.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Interop.fs" />
    <Compile Include="Syncfusion.fs" />
    <Compile Include="SfListView.fs" />
    <Compile Include="SfAppBar.fs" />
    <Compile Include="SfButton.fs" />
    <Compile Include="SfSplitButton.fs" />
    <Compile Include="SfDataManager.fs" />
    <Compile Include="SfGrid.fs" />
    <Compile Include="SfInputs.fs" />
    <Compile Include="SfComboBox.fs" />
    <Compile Include="SfMultiSelect.fs" />
    <Compile Include="SfDateTimePicker.fs" />
    <Compile Include="SfTooltip.fs" />
    <Compile Include="SfKanban.fs" />
    <Compile Include="SfDataTyped.fs" />
    <Compile Include="SfTyped.fs" />
    <Compile Include="SfModal.fs" />
    <Compile Include="SfMenuBar.fs" />
    <Compile Include="SfSideBar.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
    <PackageReference Include="Feliz" Version="3.3.3" />
    <PackageReference Include="Fable.Package.SDK" Version="1.4.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <NpmDependencies>
      <NpmPackage Name="@syncfusion/ej2-base" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-navigations" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-data" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-grids" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-buttons" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-dropdowns" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-calendars" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-inputs" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-charts" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-popups" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-schedule" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-gantt" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-notifications" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-filemanager" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-treegrid" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-progressbar" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-lists" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-react-kanban" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-kanban" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-splitbuttons" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-calendars" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-dropdowns" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-popups" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-inputs" Version="gte 34.2.0" ResolutionStrategy="Max" />
      <NpmPackage Name="@syncfusion/ej2-grids" Version="gte 34.2.0" ResolutionStrategy="Max" />
    </NpmDependencies>
  </PropertyGroup>
</Project>
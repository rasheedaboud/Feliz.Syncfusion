{
  "name": "feliz-syncfusion-quality",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fable:build": "dotnet fable Felize.Syncfusion --outDir artifacts/fable --sourceMaps",
    "verify:exports": "node scripts/verify-syncfusion-exports.mjs",
    "verify:type-safety": "node scripts/type-safety-budget.mjs",
    "test:browser": "playwright test",
    "quality": "npm run verify:exports && npm run verify:type-safety && npm run test:browser",
    "contracts:build": "dotnet fable tests/contracts --outDir artifacts/contracts --sourceMaps",
    "playground:build": "dotnet fable examples/playground --outDir artifacts/playground",
    "playground": "npm run playground:build && vite examples/playground --host 127.0.0.1"
  },
  "dependencies": {
    "@syncfusion/ej2": "34.2.8",
    "@syncfusion/ej2-base": "34.2.8",
    "@syncfusion/ej2-data": "34.2.8",
    "@syncfusion/ej2-react-buttons": "34.2.8",
    "@syncfusion/ej2-react-calendars": "34.2.8",
    "@syncfusion/ej2-react-dropdowns": "34.2.8",
    "@syncfusion/ej2-react-grids": "34.2.8",
    "@syncfusion/ej2-react-inputs": "34.2.8",
    "@syncfusion/ej2-react-lists": "34.2.8",
    "@syncfusion/ej2-react-navigations": "34.2.8",
    "@syncfusion/ej2-react-popups": "34.2.8",
    "@syncfusion/ej2-react-splitbuttons": "34.2.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@syncfusion/ej2-react-kanban": "34.2.8",
    "@syncfusion/ej2-grids": "34.2.8",
    "@syncfusion/ej2-inputs": "34.2.8",
    "@syncfusion/ej2-popups": "34.2.8",
    "@syncfusion/ej2-dropdowns": "34.2.8",
    "@syncfusion/ej2-calendars": "34.2.8",
    "@syncfusion/ej2-splitbuttons": "34.2.8",
    "@syncfusion/ej2-kanban": "34.2.8",
    "@syncfusion/ej2-react-multicolumn-combobox": "34.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.0"
  }
}

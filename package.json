{
  "name": "feliz-syncfusion-quality",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fable:build": "dotnet fable Felize.Syncfusion --outDir artifacts/fable --sourceMaps",
    "verify:exports": "node scripts/verify-syncfusion-exports.mjs",
    "verify:type-safety": "node scripts/type-safety-budget.mjs",
    "test:unit": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:crap": "node scripts/crap-score.mjs",
    "quality": "npm run verify:exports && npm run verify:type-safety && npm run test:unit && npm run test:crap"
  },
  "dependencies": {
    "@syncfusion/ej2": "^34.2.0",
    "@syncfusion/ej2-base": "^34.2.0",
    "@syncfusion/ej2-data": "^34.2.0",
    "@syncfusion/ej2-react-buttons": "^34.2.0",
    "@syncfusion/ej2-react-calendars": "^34.2.0",
    "@syncfusion/ej2-react-dropdowns": "^34.2.0",
    "@syncfusion/ej2-react-grids": "^34.2.0",
    "@syncfusion/ej2-react-inputs": "^34.2.0",
    "@syncfusion/ej2-react-lists": "^34.2.0",
    "@syncfusion/ej2-react-navigations": "^34.2.0",
    "@syncfusion/ej2-react-popups": "^34.2.0",
    "@syncfusion/ej2-react-splitbuttons": "^34.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
